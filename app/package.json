{
  "name": "zenote-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ZeNote — PWA de capture, revue et priorisation",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bout-en-bout": "npm run build && node tests/bout-en-bout.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@js-joda/core": "^3.2.0",
    "format-util": "^1.0.5"
  }
}
